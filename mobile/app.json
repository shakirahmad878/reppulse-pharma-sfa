{
  "expo": {
    "name": "RepPulse",
    "slug": "sefmed-pharma-sfa",
    "owner": "shakir878",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sefmed.sfa",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RepPulse captures periodic 15-minute background location pings during active field duty to verify doctor clinic visits.",
        "NSLocationWhenInUseUsageDescription": "RepPulse uses your location to verify arrival at doctor clinics and calculate travel allowance.",
        "NSCameraUsageDescription": "Required for geotagged selfie attendance punch-in and receipt uploads."
      }
    },
    "android": {
      "package": "com.reppulse.sfa",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RepPulse to log 15-minute periodic location fixes during field duty in Barak Division."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RepPulse to capture geotagged selfie attendance punch-ins."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "657a385d-4882-4c2c-8d20-16f04456dc70"
      }
    }
  }
}
