{
  "name": "pappu-da-company",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:website": "vite --mode website",
    "build": "tsc -b && vite build --mode portal",
    "build:portal": "tsc -b && vite build --mode portal && echo reppulse.nlcl.in > dist/CNAME",
    "build:website": "tsc -b && vite build --mode website && echo nlcl.in > dist/CNAME",
    "deploy:portal": "npm run build:portal && gh-pages -d dist --repo https://github.com/shakirahmad878/reppulse-pharma-sfa.git",
    "deploy:website": "npm run build:website && gh-pages -d dist --repo https://github.com/shakirahmad878/pharma-assam-website.git",
    "deploy": "npm run deploy:portal && npm run deploy:website",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
